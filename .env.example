# Reference list of the environment variables used by this project. Nothing loads this file automatically
# (the ETL reads os.environ only): export the variables in your shell or pass them inline per command, e.g.
#   STL_DATA_DIR=/path/to/stl-hackathon-2026-grid-starter uv run python -m utility_fingerprint_etl build

# Path to a local clone of the GRID data starter repo (never inside this repo)
STL_DATA_DIR=/path/to/stl-hackathon-2026-grid-starter
# Claude API key for build-time report generation: pass inline for the `report` command only, never commit a real
# value and never export it in the shell where Claude Code runs
ANTHROPIC_API_KEY=
# Optional: report model override (default claude-sonnet-5-5)
UF_REPORT_MODEL=
# Optional (web build): where the browser loads the aggregate JSON from (default /data)
NEXT_PUBLIC_DATA_BASE_URL=
